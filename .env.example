# Copie este arquivo para ".env" (desenvolvimento local) ou cadastre as variáveis na Vercel (produção).
# NUNCA envie o arquivo .env para o GitHub.

# Banco de dados
#  Local (sem instalar nada):  DATABASE_URL=pglite:./.data/db
#  Produção (Neon/Supabase):   DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=pglite:./.data/db

# E-mail do proprietário da loja. Só ele recebe o código do primeiro acesso do painel (/admin).
OWNER_EMAIL=

# Segredo para os códigos enviados por e-mail (32+ caracteres aleatórios). Obrigatório em produção.
AUTH_SECRET=

# Protege a rota de expiração das reservas (/api/cron/expire-reservations). A Vercel envia automaticamente no cron.
CRON_SECRET=

# Mercado Pago (Checkout Pro). Access Token da aplicação da loja (TEST-... para testes, APP_USR-... para valer).
# NUNCA coloque no código nem no navegador. Sem ele, o site registra o pedido e o pagamento é combinado pelo WhatsApp.
MP_ACCESS_TOKEN=
# "Assinatura secreta" dos Webhooks (Mercado Pago → Suas integrações → Webhooks). URL: https://SEU-SITE/api/webhooks/mercadopago
MP_WEBHOOK_SECRET=

# Botão "Entrar com Google" no painel (ID do cliente OAuth "Aplicativo da Web" do Google Cloud; não é segredo).
GOOGLE_CLIENT_ID=

# Envio de e-mails (códigos e convites). Em produção é obrigatório UM dos dois:
# a) Gmail da loja: GMAIL_USER (endereço) + GMAIL_APP_PASSWORD ("senha de app" do Google, exige verificação em 2 etapas)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# b) Resend (com domínio verificado). Localmente, sem nada configurado, os e-mails aparecem no terminal do "npm run dev".
RESEND_API_KEY=
EMAIL_FROM=

# Armazenamento das fotos em produção (Vercel Blob). Localmente as fotos vão para a pasta /uploads.
BLOB_READ_WRITE_TOKEN=
