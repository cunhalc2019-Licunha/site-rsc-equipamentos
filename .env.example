# Copie este arquivo para ".env" (desenvolvimento local) ou cadastre as variáveis na Vercel (produção).
# NUNCA envie o arquivo .env para o GitHub.

# Banco de dados
#  Local (sem instalar nada):  DATABASE_URL=pglite:./.data/db
#  Produção (Neon/Supabase):   DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=pglite:./.data/db

# E-mail do proprietário da loja. Só ele recebe o código do primeiro acesso do painel (/admin).
OWNER_EMAIL=

# Segredo para os códigos enviados por e-mail (32+ caracteres aleatórios). Obrigatório em produção.
AUTH_SECRET=

# Protege a rota de expiração das reservas (/api/cron/expire-reservations). A Vercel envia automaticamente no cron.
CRON_SECRET=

# Envio de e-mails (códigos e convites) pelo Resend. Em produção são obrigatórios.
# Localmente, sem estas variáveis, os e-mails aparecem no terminal do "npm run dev".
RESEND_API_KEY=
EMAIL_FROM=

# Armazenamento das fotos em produção (Vercel Blob). Localmente as fotos vão para a pasta /uploads.
BLOB_READ_WRITE_TOKEN=
